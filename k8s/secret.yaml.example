apiVersion: v1
kind: Secret
metadata:
  name: wrenchbox-secret
  namespace: wrenchbox
type: Opaque
stringData:
  POSTGRES_DB: wrenchbox
  POSTGRES_USER: postgres
  POSTGRES_PASSWORD: change-me
  Jwt__Secret: replace-with-at-least-32-characters
  Webhook__Secret: replace-with-webhook-secret
  ConnectionStrings__Default: Host=postgres;Port=5432;Database=wrenchbox;Username=postgres;Password=change-me
